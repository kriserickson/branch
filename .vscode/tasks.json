{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Branch.app (debug)",
            "type": "shell",
            "command": "zsh",
            "args": ["${workspaceFolder}/Scripts/build-app.sh", "debug"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Test Branch",
            "type": "shell",
            "command": "swift",
            "args": ["test"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
